//@version=6
// Oliver Vélez – Los 4 Fantásticos (Fab 4)
//
// Zona de soporte/resistencia para la primera hora de la sesión regular, construida
// con 4 elementos de la sesión anterior:
//   1. SMA 200 al cierre previo
//   2. SMA 20 al cierre previo
//   3. Precio de cierre previo
//   4. Máximo y mínimo del tramo final de la sesión previa (30–60 min, configurable)
//
// Lectura:
//   - Abre por encima de la zona -> sesgo alcista (buscar largos)
//   - Abre por debajo de la zona -> sesgo bajista (buscar cortos)
//   - Dentro de la zona          -> zona trampa, no operar
//   - El sesgo se confirma con N cierres consecutivos fuera de la caja y se
//     invalida si el precio vuelve a cerrar dentro de ella.
//
// Pensado para gráficos intradía (ideal 2 min). Fuente: interpretaciones públicas del
// método; los parámetros exactos (ventana final, confirmación) varían entre autores.
// Solo para fines educativos. No es asesoría financiera.
indicator("Oliver Vélez – Los 4 Fantásticos", shorttitle="Fab4", overlay=true, max_labels_count=500)

// ── Entradas ──────────────────────────────────────────────────────────────────
grpS = "Sesión"
tz  = input.string("America/New_York", "Zona horaria de la sesión", group=grpS)
rth = input.session("0930-1600", "Sesión regular (RTH)", group=grpS)

grpZ = "Zona"
smaFastLen = input.int(20, "SMA rápida", minval=1, group=grpZ)
smaSlowLen = input.int(200, "SMA lenta", minval=1, group=grpZ)
lateMins   = input.int(45, "Minutos finales de la sesión previa", minval=5, maxval=120, group=grpZ,
     tooltip="Las fuentes usan entre 30 y 60 minutos. Con estos minutos se toma el máximo y mínimo del final de la sesión previa.")
useRange   = input.bool(true, "Incluir máx/mín del tramo final en la caja", group=grpZ)

grpB = "Sesgo"
confirmN   = input.int(2, "Cierres consecutivos fuera de la caja", minval=1, maxval=10, group=grpB)
windowMins = input.int(60, "Ventana de operación tras la apertura (min)", minval=5, maxval=390, group=grpB)

grpV = "Visual"
showLabels = input.bool(true, "Etiqueta de apertura", group=grpV)
showTable  = input.bool(true, "Tabla de resumen", group=grpV)

// ── Estado de sesión ──────────────────────────────────────────────────────────
s20  = ta.sma(close, smaFastLen)
s200 = ta.sma(close, smaSlowLen)

inRth   = timeframe.isintraday and not na(time(timeframe.period, rth, tz))
newSess = inRth and not inRth[1]

var array<float> dayHigh = array.new<float>()
var array<float> dayLow  = array.new<float>()
var array<int>   dayTc   = array.new<int>()

var float lastClose = na
var float lastS20   = na
var float lastS200  = na

var float zTop     = na
var float zBot     = na
var float lvlClose = na
var float lvl20    = na
var float lvl200   = na
var float lateHi   = na
var float lateLo   = na

var int sessStart = na
var int barsIn    = 0
var int bias      = 0   // 1 largos, -1 cortos, 0 sin sesgo / trampa

// ── Al abrir una sesión: construir la zona con los datos de la sesión previa ──
if newSess
    barsIn    := 0
    bias      := 0
    sessStart := time
    if dayTc.size() > 0 and not na(lastS200)
        cutoff = dayTc.last() - lateMins * 60000
        float hi = dayHigh.last()
        float lo = dayLow.last()
        for i = dayTc.size() - 1 to 0
            if dayTc.get(i) > cutoff
                hi := math.max(hi, dayHigh.get(i))
                lo := math.min(lo, dayLow.get(i))
            else
                break
        lvlClose := lastClose
        lvl20    := lastS20
        lvl200   := lastS200
        lateHi   := hi
        lateLo   := lo
        zTop     := useRange ? math.max(lastS20, lastS200, lastClose, hi) : math.max(lastS20, lastS200, lastClose)
        zBot     := useRange ? math.min(lastS20, lastS200, lastClose, lo) : math.min(lastS20, lastS200, lastClose)
    else
        lvlClose := na
        lvl20    := na
        lvl200   := na
        lateHi   := na
        lateLo   := na
        zTop     := na
        zBot     := na
    dayHigh.clear()
    dayLow.clear()
    dayTc.clear()

if inRth
    barsIn += 1
    dayHigh.push(high)
    dayLow.push(low)
    dayTc.push(time_close)
    lastClose := close
    lastS20   := s20
    lastS200  := s200

// ── Sesgo ─────────────────────────────────────────────────────────────────────
hasZone  = not na(zTop)
inWindow = inRth and hasZone and (time_close - sessStart) <= windowMins * 60000

lowestClose  = ta.lowest(close, confirmN)
highestClose = ta.highest(close, confirmN)

prevBias = bias
if inWindow and barsIn >= confirmN
    if lowestClose > zTop
        bias := 1
    else if highestClose < zBot
        bias := -1
    else if bias == 1 and close <= zTop
        bias := 0
    else if bias == -1 and close >= zBot
        bias := 0

longSig  = bias == 1  and prevBias != 1
shortSig = bias == -1 and prevBias != -1
failSig  = bias == 0  and prevBias != 0

// ── Dibujo ────────────────────────────────────────────────────────────────────
showZone = inRth and hasZone

pTop = plot(showZone ? zTop : na, "Zona – techo", color=color.new(color.orange, 20), linewidth=2, style=plot.style_linebr)
pBot = plot(showZone ? zBot : na, "Zona – piso",  color=color.new(color.orange, 20), linewidth=2, style=plot.style_linebr)
fillCol = bias == 1 ? color.new(color.green, 85) : bias == -1 ? color.new(color.red, 85) : color.new(color.gray, 80)
fill(pTop, pBot, color=fillCol, title="Zona")

plot(showZone ? lvlClose : na, "Cierre previo", color=color.new(color.gray, 20),   style=plot.style_linebr)
plot(showZone ? lvl20    : na, "SMA rápida previa", color=color.new(color.blue, 20),   style=plot.style_linebr)
plot(showZone ? lvl200   : na, "SMA lenta previa",  color=color.new(color.purple, 20), style=plot.style_linebr)
plot(showZone ? lateHi   : na, "Máx tramo final", color=color.new(color.teal, 40), style=plot.style_linebr)
plot(showZone ? lateLo   : na, "Mín tramo final", color=color.new(color.teal, 40), style=plot.style_linebr)

plotshape(longSig,  "Sesgo largo",   shape.triangleup,   location.belowbar, color.green, text="Largos", textcolor=color.green, size=size.small)
plotshape(shortSig, "Sesgo corto",   shape.triangledown, location.abovebar, color.red,   text="Cortos", textcolor=color.red,   size=size.small)
plotshape(failSig,  "Sesgo fallido", shape.xcross,       location.abovebar, color.gray,  text="Falló",  textcolor=color.gray,  size=size.tiny)

if showLabels and newSess and hasZone
    openPos = open > zTop ? 1 : open < zBot ? -1 : 0
    txt = openPos == 1 ? "Abre ARRIBA de la zona" : openPos == -1 ? "Abre ABAJO de la zona" : "Abre DENTRO – zona trampa"
    col = openPos == 1 ? color.green : openPos == -1 ? color.red : color.gray
    label.new(bar_index, openPos == -1 ? high : low, txt, style=openPos == -1 ? label.style_label_down : label.style_label_up,
         color=color.new(col, 20), textcolor=color.white, size=size.small)

// ── Tabla ─────────────────────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 7, border_width=1)
if showTable and barstate.islast
    if not timeframe.isintraday
        table.cell(info, 0, 0, "Fab4: usar un gráfico intradía (ideal 2 min)", text_color=color.white, bgcolor=color.new(color.gray, 20))
    else
        biasTxt = bias == 1 ? "LARGOS" : bias == -1 ? "CORTOS" : hasZone ? "Sin sesgo / trampa" : "-"
        biasCol = bias == 1 ? color.green : bias == -1 ? color.red : color.gray
        table.cell(info, 0, 0, "Techo zona",    text_color=color.white, bgcolor=color.new(color.gray, 30))
        table.cell(info, 1, 0, hasZone ? str.tostring(zTop, format.mintick) : "-", text_color=color.white, bgcolor=color.new(color.gray, 30))
        table.cell(info, 0, 1, "Piso zona",     text_color=color.white, bgcolor=color.new(color.gray, 30))
        table.cell(info, 1, 1, hasZone ? str.tostring(zBot, format.mintick) : "-", text_color=color.white, bgcolor=color.new(color.gray, 30))
        table.cell(info, 0, 2, "Cierre previo", text_color=color.white, bgcolor=color.new(color.gray, 30))
        table.cell(info, 1, 2, hasZone ? str.tostring(lvlClose, format.mintick) : "-", text_color=color.white, bgcolor=color.new(color.gray, 30))
        table.cell(info, 0, 3, "SMA " + str.tostring(smaFastLen), text_color=color.white, bgcolor=color.new(color.gray, 30))
        table.cell(info, 1, 3, hasZone ? str.tostring(lvl20, format.mintick) : "-", text_color=color.white, bgcolor=color.new(color.gray, 30))
        table.cell(info, 0, 4, "SMA " + str.tostring(smaSlowLen), text_color=color.white, bgcolor=color.new(color.gray, 30))
        table.cell(info, 1, 4, hasZone ? str.tostring(lvl200, format.mintick) : "-", text_color=color.white, bgcolor=color.new(color.gray, 30))
        table.cell(info, 0, 5, "Tramo final",   text_color=color.white, bgcolor=color.new(color.gray, 30))
        table.cell(info, 1, 5, hasZone ? str.tostring(lateLo, format.mintick) + " – " + str.tostring(lateHi, format.mintick) : "-", text_color=color.white, bgcolor=color.new(color.gray, 30))
        table.cell(info, 0, 6, "Sesgo",         text_color=color.white, bgcolor=color.new(color.gray, 30))
        table.cell(info, 1, 6, biasTxt,         text_color=color.white, bgcolor=color.new(biasCol, 20))

// ── Alertas ───────────────────────────────────────────────────────────────────
alertcondition(longSig,  "Fab4 – sesgo largo confirmado",  "Fab4: precio confirmado por encima de la zona")
alertcondition(shortSig, "Fab4 – sesgo corto confirmado",  "Fab4: precio confirmado por debajo de la zona")
alertcondition(failSig,  "Fab4 – sesgo invalidado",        "Fab4: el precio volvió a cerrar dentro de la zona")
