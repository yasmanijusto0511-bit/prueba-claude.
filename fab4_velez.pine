//@version=6
// Oliver Vélez – Los 4 Fantásticos (Fab 4) + "juego del color"
//
// Los 4 Fantásticos (ítems 2 a 5 de su lista de "5 cosas que necesitamos"):
//   1. SMA 20 al cierre previo
//   2. SMA 200 al cierre previo
//   3. Cierre del día anterior
//   4. Máximo y mínimo de los últimos ~45 min de la sesión previa
// La caja va del elemento más alto al más bajo y se extiende al día de hoy.
//
// Estado estrecho (Vélez): las mejores jugadas nacen cuando la SMA20 y la SMA200 están relativamente
// cerca una de la otra (comprimidas). Si al cierre previo su separación supera el umbral (en velas
// promedio de 50), ese día no se opera. El umbral es ajustable; Vélez no da un número.
//
// Ubicación: la apertura del día respecto a la caja.
//   Abre por encima -> solo largos. Abre por debajo -> solo cortos. Dentro -> sin ubicación.
//
// Gatillo (gráfico de 2 min). Ejemplo bajista (el alcista es el espejo):
//   - La barra de referencia es la primera barra del día.
//   - Entra en corto cuando una barra posterior rompe el BAJO de la referencia.
//   - Stop: por encima del ALTO de la referencia (se arriesga una barra).
//   - Si aparece una barra de color opuesto (verde), esa barra pasa a ser la nueva
//     referencia; se sigue marcando su bajo hasta que una barra lo rompa.
//   - Tras cada entrada, una nueva barra de color opuesto da otra entrada (hasta N).
//   - Tras un stop-out, la siguiente barra de color opuesto da un segundo intento.
//
// Salida R1 (regla propia del usuario, no es de Vélez):
//   - Al ganar 1 cabeza (+1R = lo mismo que arriesgaba, de la entrada al stop) marca "R1 ½":
//     se vende la mitad y el stop de la otra mitad pasa al precio de entrada.
//   - Después el stop se lleva vela a vela: solo cuentan las velas de tu color de tendencia
//     (verdes si vas largo, rojas si vas corto) y que no sean "mini". Largo: stop en el bajo
//     de cada vela verde; corto: stop en el alto de cada vela roja. Solo se mueve a favor.
//   - Sigue hasta que el precio toque el stop móvil (aunque pase la primera hora).
//   - Solo se sigue la ÚLTIMA entrada del día.
//
// Fuente: video de Oliver Velez Trading En Español (ver notas_4_fantasticos_velez.md).
// El video no define objetivos ni salidas; la salida R1 es la del usuario.
// Solo para fines educativos. No es asesoría financiera.
indicator("Oliver Vélez – Los 4 Fantásticos", shorttitle="Fab4", overlay=true, max_labels_count=500)

// ── Entradas ──────────────────────────────────────────────────────────────────
grpS = "Sesión"
tz  = input.string("America/New_York", "Zona horaria de la sesión", group=grpS)
rth = input.session("0930-1600", "Sesión regular (RTH)", group=grpS)

grpZ = "Los 4 Fantásticos"
smaFastLen = input.int(20, "SMA rápida", minval=1, group=grpZ)
smaSlowLen = input.int(200, "SMA lenta", minval=1, group=grpZ)
lateMins   = input.int(45, "Minutos finales de la sesión previa", minval=5, maxval=120, group=grpZ,
     tooltip="Vélez: 'no quiero una hora, no quiero dos horas, aproximadamente 45 minutos'.")
narrowFilter = input.bool(true, "Solo operar con las medias comprimidas (estado estrecho)", group=grpZ,
     tooltip="Vélez: las mejores jugadas nacen cuando la SMA20 y la SMA200 están relativamente cerca una de la otra (estado estrecho). Si al cierre previo están separadas más que el umbral, ese día no se opera.")
narrowMult = input.float(3.0, "Estrecho: separación SMA20–SMA200 máxima (en velas promedio de 50)", minval=0.1, step=0.5, group=grpZ,
     tooltip="Vélez no da un número (lo muestra en gráficos). 3 velas promedio es un valor mío por defecto: ajústalo viendo tus gráficos.")

grpE = "Entradas"
maxEntries = input.int(5, "Máximo de entradas por día", minval=1, maxval=10, group=grpE,
     tooltip="Vélez: en un día de tendencia hay entre 2 y 5 oportunidades de entrada.")
windowMins = input.int(60, "Ventana de operación tras la apertura (min)", minval=5, maxval=390, group=grpE,
     tooltip="Solo se operan los primeros 60 minutos (09:30–10:30 hora de Nueva York). Vélez no fija una ventana en el video; 390 = toda la sesión.")

grpR = "Salida R1"
useR1 = input.bool(true, "Marcar R1: vender la mitad al ganar 1 cabeza (+1R)", group=grpR)
trailOn = input.bool(true, "Luego llevar el stop vela a vela (solo velas de tu color)", group=grpR)
miniFactor = input.float(0.5, "Vela mini: rango menor a X veces el rango promedio (10 velas)", minval=0.05, maxval=2.0, step=0.05, group=grpR,
     tooltip="Las velas mini no mueven el stop. Es un valor mío por defecto: ajústalo a lo que tú consideras una vela mini.")
trailTicks = input.int(0, "Ticks de colchón bajo/sobre la vela", minval=0, group=grpR)
sizeTrigger = input.bool(true, "Entrar también cuando la vela ya alcanzó tamaño adecuado", group=grpE,
     tooltip="Además de entrar al superar la vela de color opuesto, entra en cuanto la vela en formación recorre desde su apertura el tamaño de una vela grande (a favor de la ubicación).")
bigAvgMult = input.float(2.5, "Vela grande: cuerpo ≥ X veces el cuerpo promedio (20 velas)", minval=0.5, step=0.1, group=grpE)
bigAtrMult = input.float(1.5, "Vela grande: cuerpo ≥ X veces el ATR (14)", minval=0.5, step=0.1, group=grpE,
     tooltip="Valores de 'Los 3 motores' (2.5 y 1.5). El tamaño adecuado es el mayor de los dos umbrales.")
maStop = input.bool(true, "Stop del otro lado de la SMA20/SMA200 si la entrada está cerca de ella", group=grpE,
     tooltip="Si el precio de entrada está muy cerca de la SMA20 o de la SMA200, el stop va encima de esa media (en cortos) o debajo (en largos), y no en el extremo de la vela de referencia.")
maNearMult = input.float(1.0, "Cerca de la media: distancia máxima (en velas promedio de 20)", minval=0.1, step=0.1, group=grpE,
     tooltip="Vale 'cerca' cuando entre la entrada y la media hay como máximo esta cantidad de velas promedio (rango de 20 velas). Como en tus bots: a una vela promedio o menos. Si están cerca las dos medias, el stop va del otro lado de la más lejana.")
miniRefFilter = input.bool(true, "No entrar con una vela mini como referencia", group=grpE,
     tooltip="Una vela mini (ver 'Vela mini' en Salida R1) no puede ser la referencia del gatillo. Evita entradas con riesgo diminuto.")

grpV = "Visual"
showLabels = input.bool(true, "Etiqueta de apertura", group=grpV)
showTable  = input.bool(true, "Tabla de resumen", group=grpV)

// ── Estado de sesión ──────────────────────────────────────────────────────────
s20  = ta.sma(close, smaFastLen)
s200 = ta.sma(close, smaSlowLen)
a50now = ta.sma(high - low, 50)   // vela promedio de 50 velas (rango alto-bajo)

inRth   = timeframe.isintraday and not na(time(timeframe.period, rth, tz))
newSess = inRth and not inRth[1]

var array<float> dayHigh = array.new<float>()
var array<float> dayLow  = array.new<float>()
var array<int>   dayTc   = array.new<int>()

var float lastClose = na
var float lastS20   = na
var float lastS200  = na
var float lastA50   = na
var float sepRatio  = na   // separación SMA20–SMA200 al cierre previo, en velas promedio de 50
var bool  narrowOk  = true // medias comprimidas (estado estrecho)

var float zTop     = na
var float zBot     = na
var float lvlClose = na
var float lvl20    = na
var float lvl200   = na
var float lateHi   = na
var float lateLo   = na

var int sessStart = na
var int barsIn    = 0

var int   loc     = 0     // 1 abre arriba, -1 abre abajo, 0 dentro / sin zona
var int   bar1Col = 0     // color de la primera barra: 1 verde, -1 roja, 0 doji
var float refH    = na    // barra de referencia (alto)
var float refL    = na    // barra de referencia (bajo)
var bool  refOk   = false // hay una referencia pendiente de romperse
var bool  inTrade = false
var float stopPx  = na
var int   entries = 0
var float entryPx = na    // precio de entrada de la última entrada
var float r1Px    = na    // precio donde se gana 1 cabeza (+1R)
var int   r1State = 0     // 0 antes de R1, 1 = mitad vendida y stop móvil activo

// ── Al abrir una sesión: construir la caja con los datos de la sesión previa ──
if newSess
    barsIn    := 0
    sessStart := time
    if dayTc.size() > 0 and not na(lastS200)
        cutoff = dayTc.last() - lateMins * 60000
        float hi = dayHigh.last()
        float lo = dayLow.last()
        for i = dayTc.size() - 1 to 0
            if dayTc.get(i) > cutoff
                hi := math.max(hi, dayHigh.get(i))
                lo := math.min(lo, dayLow.get(i))
            else
                break
        lvlClose := lastClose
        lvl20    := lastS20
        lvl200   := lastS200
        lateHi   := hi
        lateLo   := lo
        zTop     := math.max(lastS20, lastS200, lastClose, hi)
        zBot     := math.min(lastS20, lastS200, lastClose, lo)
        sepRatio := lastA50 > 0 ? math.abs(lastS20 - lastS200) / lastA50 : na
    else
        sepRatio := na
        lvlClose := na
        lvl20    := na
        lvl200   := na
        lateHi   := na
        lateLo   := na
        zTop     := na
        zBot     := na
    dayHigh.clear()
    dayLow.clear()
    dayTc.clear()

if inRth
    barsIn += 1
    dayHigh.push(high)
    dayLow.push(low)
    dayTc.push(time_close)
    lastClose := close
    lastS20   := s20
    lastS200  := s200
    lastA50   := a50now

hasZone  = not na(zTop)
inWindow = inRth and hasZone and (time_close - sessStart) <= windowMins * 60000
avgRange = ta.sma(high - low, 10)
avg20Range = ta.sma(high - low, 20)   // vela promedio de 20 velas (para "cerca de la media")
isMiniBar = (high - low) < miniFactor * avgRange
avgBody20 = ta.sma(math.abs(close - open), 20)
atr14     = ta.atr(14)
bigSize   = math.max(bigAvgMult * avgBody20[1], bigAtrMult * atr14[1])   // tamaño de vela grande (de las velas previas)

// ── Ubicación y primera barra ─────────────────────────────────────────────────
if newSess
    narrowOk := not narrowFilter or (not na(sepRatio) and sepRatio <= narrowMult)
    loc     := hasZone and narrowOk ? (open > zTop ? 1 : open < zBot ? -1 : 0) : 0
    bar1Col := close > open ? 1 : close < open ? -1 : 0
    refH    := high
    refL    := low
    refOk   := loc != 0 and not (miniRefFilter and isMiniBar)
    inTrade := false
    stopPx  := na
    entries := 0
    entryPx := na
    r1Px    := na
    r1State := 0

// ── Juego del color: gatillos, stops y salida R1 ──────────────────────────────
bool entryLong  = false
bool entryShort = false
bool stopOut    = false   // el precio tocó el stop (inicial o móvil)
bool stopLoss   = false   // stop inicial: pérdida de 1R
bool trailOut   = false   // stop móvil tras R1: salida de la mitad restante
bool r1Hit      = false   // se ganó 1 cabeza: vender la mitad

inManage = inRth and hasZone and loc != 0 and barsIn >= 2

if inManage
    // 1) Stop de la última entrada (tras R1 es el stop móvil de la mitad restante)
    if inTrade
        bool hitStop = loc == -1 ? high >= stopPx : low <= stopPx
        if hitStop
            stopOut  := true
            trailOut := r1State == 1
            stopLoss := r1State == 0
            inTrade  := false
            r1State  := 0
    // 2) R1 y stop móvil vela a vela (desde la barra siguiente a R1)
    if inTrade
        if r1State == 0
            if useR1 and (loc == -1 ? low <= r1Px : high >= r1Px)
                r1Hit   := true
                r1State := 1
                stopPx  := entryPx
        else if trailOn
            bool trendColor = loc == 1 ? close > open : close < open
            if trendColor and not isMiniBar
                stopPx := loc == 1 ? math.max(stopPx, low - trailTicks * syminfo.mintick) : math.min(stopPx, high + trailTicks * syminfo.mintick)
    // Entradas y referencias solo dentro de la ventana de operación
    if inWindow
        // 3) Gatillo: la barra rompe el bajo (cortos) o el alto (largos) de la referencia
        if refOk and entries < maxEntries
            bool sizeOk    = sizeTrigger and not na(bigSize)
            bool sizeShort = sizeOk and open - low >= bigSize
            bool sizeLong  = sizeOk and high - open >= bigSize
            if loc == -1 and (low < refL or sizeShort)
                entryShort := true
                stopPx  := refH
                entryPx := sizeOk ? math.min(open, math.max(refL, open - bigSize)) : math.min(open, refL)
            else if loc == 1 and (high > refH or sizeLong)
                entryLong := true
                stopPx  := refL
                entryPx := sizeOk ? math.max(open, math.min(refH, open + bigSize)) : math.max(open, refH)
            if entryShort or entryLong
                // Entrada cerca de la SMA20/SMA200: el stop va del otro lado de la media, no en la vela
                if maStop and not na(avg20Range)
                    float nearDist = maNearMult * avg20Range
                    float cand = na
                    if loc == -1
                        if s20 > entryPx and s20 - entryPx <= nearDist
                            cand := s20
                        if s200 > entryPx and s200 - entryPx <= nearDist
                            cand := na(cand) ? s200 : math.max(cand, s200)
                        if not na(cand)
                            stopPx := cand + tick
                    else
                        if s20 < entryPx and entryPx - s20 <= nearDist
                            cand := s20
                        if s200 < entryPx and entryPx - s200 <= nearDist
                            cand := na(cand) ? s200 : math.min(cand, s200)
                        if not na(cand)
                            stopPx := cand - tick
                inTrade := true
                entries += 1
                refOk   := false
                r1State := 0
                r1Px    := loc == -1 ? entryPx - (stopPx - entryPx) : entryPx + (entryPx - stopPx)
        // 4) Nueva referencia: barra de color opuesto a la ubicación (verde si abre abajo)
        if not (entryShort or entryLong)
            isOpp = loc == -1 ? close > open : close < open
            if isOpp and not (miniRefFilter and isMiniBar)
                refH  := high
                refL  := low
                refOk := true

// ── Dibujo ────────────────────────────────────────────────────────────────────
showZone = inRth and hasZone

pTop = plot(showZone ? zTop : na, "Caja – techo", color=color.new(color.orange, 20), linewidth=2, style=plot.style_linebr)
pBot = plot(showZone ? zBot : na, "Caja – piso",  color=color.new(color.orange, 20), linewidth=2, style=plot.style_linebr)
fillCol = loc == 1 ? color.new(color.green, 85) : loc == -1 ? color.new(color.red, 85) : color.new(color.gray, 80)
fill(pTop, pBot, color=fillCol, title="Caja")

plot(showZone ? lvlClose : na, "Cierre previo",      color=color.new(color.gray, 20),   style=plot.style_linebr)
plot(showZone ? lvl20    : na, "SMA rápida previa",  color=color.new(color.blue, 20),   style=plot.style_linebr)
plot(showZone ? lvl200   : na, "SMA lenta previa",   color=color.new(color.purple, 20), style=plot.style_linebr)
plot(showZone ? lateHi   : na, "Máx tramo final",    color=color.new(color.teal, 40),   style=plot.style_linebr)
plot(showZone ? lateLo   : na, "Mín tramo final",    color=color.new(color.teal, 40),   style=plot.style_linebr)

trigLvl = inWindow and refOk and loc != 0 and barsIn >= 1 ? (loc == -1 ? refL : refH) : na
plot(trigLvl, "Gatillo (rompe la referencia)", color=color.new(color.yellow, 0), style=plot.style_linebr, linewidth=1)
plot(inManage and inTrade ? stopPx : na, "Stop / stop móvil", color=r1State == 1 ? color.green : color.red, style=plot.style_linebr, linewidth=1)
plot(inManage and inTrade and r1State == 0 ? r1Px : na, "R1 (+1R)", color=color.new(color.lime, 0), style=plot.style_linebr, linewidth=1)

plotshape(entryLong,  "Entrada larga", shape.triangleup,   location.belowbar, color.green, text="Largo", textcolor=color.green, size=size.small)
plotshape(entryShort, "Entrada corta", shape.triangledown, location.abovebar, color.red,   text="Corto", textcolor=color.red,   size=size.small)
plotshape(r1Hit ? r1Px : na, "R1: vender la mitad", shape.diamond, location.absolute, color.lime, text="R1 ½", textcolor=color.lime, size=size.tiny)
plotshape(stopLoss,   "Stop",          shape.xcross,       location.abovebar, color.gray,  text="Stop",  textcolor=color.gray,  size=size.tiny)
plotshape(trailOut,   "Salida (stop móvil)", shape.xcross, location.abovebar, color.green, text="Salida", textcolor=color.green, size=size.tiny)

if showLabels and newSess and hasZone
    txt = not narrowOk ? "Medias abiertas (" + str.tostring(sepRatio, "#.0") + " velas): hoy no se opera" : loc == 1 ? "Abre ARRIBA de la caja: solo largos" : loc == -1 ? "Abre ABAJO de la caja: solo cortos" : "Abre DENTRO de la caja: sin ubicación"
    col = loc == 1 ? color.green : loc == -1 ? color.red : color.gray
    label.new(bar_index, loc == -1 ? high : low, txt, style=loc == -1 ? label.style_label_down : label.style_label_up,
         color=color.new(col, 20), textcolor=color.white, size=size.small)

// ── Tabla ─────────────────────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 10, border_width=1)
cellBg = color.new(color.gray, 30)
if showTable and barstate.islast
    if not timeframe.isintraday
        table.cell(info, 0, 0, "Fab4: usar un gráfico intradía (Vélez usa 2 min)", text_color=color.white, bgcolor=color.new(color.gray, 20))
    else
        locTxt  = not hasZone ? "-" : loc == 1 ? "ARRIBA" : loc == -1 ? "ABAJO" : "DENTRO"
        locCol  = loc == 1 ? color.green : loc == -1 ? color.red : color.gray
        confirm = not hasZone or loc == 0 ? "-" : (loc == bar1Col ? "Confirma" : bar1Col == 0 ? "Doji" : "Conflicto")
        trigTxt = na(trigLvl) ? "-" : str.tostring(trigLvl, format.mintick)
        stopTxt = inTrade ? str.tostring(stopPx, format.mintick) : "-"
        r1Txt   = not inTrade ? "-" : r1State == 1 ? "½ vendida" : str.tostring(r1Px, format.mintick)
        tfOk    = timeframe.isminutes and timeframe.multiplier == 2
        table.cell(info, 0, 0, "Techo caja",   text_color=color.white, bgcolor=cellBg)
        table.cell(info, 1, 0, hasZone ? str.tostring(zTop, format.mintick) : "-", text_color=color.white, bgcolor=cellBg)
        table.cell(info, 0, 1, "Piso caja",    text_color=color.white, bgcolor=cellBg)
        table.cell(info, 1, 1, hasZone ? str.tostring(zBot, format.mintick) : "-", text_color=color.white, bgcolor=cellBg)
        table.cell(info, 0, 2, "Ubicación",    text_color=color.white, bgcolor=cellBg)
        table.cell(info, 1, 2, locTxt,         text_color=color.white, bgcolor=color.new(locCol, 20))
        table.cell(info, 0, 3, "1ª barra",     text_color=color.white, bgcolor=cellBg)
        table.cell(info, 1, 3, confirm,        text_color=color.white, bgcolor=cellBg)
        table.cell(info, 0, 4, "Entradas",     text_color=color.white, bgcolor=cellBg)
        table.cell(info, 1, 4, str.tostring(entries) + " / " + str.tostring(maxEntries), text_color=color.white, bgcolor=cellBg)
        table.cell(info, 0, 5, "Gatillo",      text_color=color.white, bgcolor=cellBg)
        table.cell(info, 1, 5, trigTxt,        text_color=color.white, bgcolor=cellBg)
        table.cell(info, 0, 6, r1State == 1 ? "Stop móvil" : "Stop", text_color=color.white, bgcolor=cellBg)
        table.cell(info, 1, 6, stopTxt,        text_color=color.white, bgcolor=cellBg)
        table.cell(info, 0, 7, "R1 (+1R)",     text_color=color.white, bgcolor=cellBg)
        table.cell(info, 1, 7, r1Txt,          text_color=color.white, bgcolor=r1State == 1 ? color.new(color.green, 20) : cellBg)
        table.cell(info, 0, 9, "SMA20–SMA200", text_color=color.white, bgcolor=cellBg)
        table.cell(info, 1, 9, na(sepRatio) ? "-" : str.tostring(sepRatio, "#.0") + " velas " + (narrowOk ? "(estrecho)" : "(amplio)"), text_color=color.white, bgcolor=narrowOk ? cellBg : color.new(color.orange, 20))
        table.cell(info, 0, 8, "Marco",        text_color=color.white, bgcolor=cellBg)
        table.cell(info, 1, 8, tfOk ? "2 min OK" : "usar 2 min", text_color=color.white, bgcolor=tfOk ? cellBg : color.new(color.orange, 20))

// ── Alertas ───────────────────────────────────────────────────────────────────
alertcondition(entryLong,  "Fab4 – entrada larga",  "Fab4: rompe el alto de la referencia (largo)")
alertcondition(entryShort, "Fab4 – entrada corta",  "Fab4: rompe el bajo de la referencia (corto)")
alertcondition(stopLoss,   "Fab4 – stop tocado",    "Fab4: el precio tocó el stop de la última entrada")
alertcondition(r1Hit,      "Fab4 – R1 alcanzado",   "Fab4: ganó 1 cabeza (+1R): vender la mitad y subir el stop a la entrada")
alertcondition(trailOut,   "Fab4 – salida por stop móvil", "Fab4: el precio tocó el stop móvil; sale la mitad restante")
